# ═══════════════════════════════════════════════════════════════
# .env.example — Copier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ── Base de données (MongoDB Atlas en prod, local en dev) ─────
# Dev local    : mongodb://localhost:27017/oilai_invest
# Prod Atlas   : mongodb+srv://user:pass@cluster.mongodb.net/oilai_invest
MONGODB_URI=mongodb+srv://onlymovieen_db_user:<db_password>@cluster0.guv2u9i.mongodb.net/oilai_invest?appName=Cluster0

# ── JWT (secret long et aléatoire, min 32 caractères) ─────────
JWT_SECRET=changez_moi_par_une_chaine_tres_longue_et_aleatoire_32chars
JWT_EXPIRES_IN=7d

# ── Serveur ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS — URL de votre frontend ──────────────────────────────
# Dev local    : http://localhost:5173
# Prod (Vercel custom domain) : https://oilai-invest.online
FRONTEND_URL=https://oilai-invest.online

# ── Upload des preuves de dépôt ────────────────────────────────
MAX_FILE_SIZE=5242880
